<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The app has no third-party runtime packages. An explicit source avoids
       inheriting machine-specific NuGet settings and also lets self-contained
       publish restore Microsoft's runtime packs when they are not installed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
