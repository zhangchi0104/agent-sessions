<Window
    x:Class="TokenStats.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TokenStats.App.Controls"
    Title="TokenStats Settings"
    Icon="/TokenStats;component/Assets/TokenStats.ico"
    Width="760"
    Height="500"
    MinWidth="480"
    MinHeight="320"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    ShowInTaskbar="True"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterScreen">
    <Grid x:Name="AppearanceRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.ColumnSpan="2"
            Background="{DynamicResource AppBackgroundImageBrush}"
            IsHitTestVisible="False" />

        <Border
            Grid.Column="0"
            Padding="14,18"
            Background="{DynamicResource SubtleBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,2,8,18">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="TokenStats" />
                    <TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Settings" />
                </StackPanel>
                <ListBox
                    x:Name="Navigation"
                    BorderThickness="0"
                    Background="Transparent"
                    SelectionChanged="Navigation_OnSelectionChanged"
                    SelectedIndex="0">
                    <ListBox.Resources>
                        <Style
                            TargetType="ListBoxItem"
                            BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Resources>
                    <ListBoxItem Content="Accounts" Tag="accounts" />
                    <ListBoxItem Content="Display" Tag="display" />
                    <ListBoxItem Content="Appearance" Tag="appearance" />
                    <ListBoxItem Content="About" Tag="about" />
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer
                x:Name="AccountsPage"
                Padding="28,24"
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Accounts" />
                    <TextBlock
                        Margin="0,4,0,20"
                        Style="{StaticResource SecondaryText}"
                        Text="Connect the Coding Agents whose Usage Windows you want to see." />
                    <StackPanel x:Name="AccountsPanel" />
                    <TextBlock
                        Margin="2,16,2,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Tokens are stored in Windows Credential Manager and are used only to read usage." />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="DisplayPage"
                Padding="28,24"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Display" />

                    <TextBlock Margin="0,22,0,6" Style="{StaticResource SectionTitle}" Text="Primary subscription" />
                    <ComboBox
                        x:Name="PrimaryAgentCombo"
                        Width="260"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Id"
                        SelectionChanged="PrimaryAgentCombo_OnSelectionChanged" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="The primary subscription is shown first in the flyout and tray summary." />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Order" />
                    <Border Padding="12" Style="{StaticResource CardBorder}">
                        <StackPanel x:Name="AgentOrderPanel" />
                    </Border>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Nothing to arrange yet — the primary leads and the only other subscription follows." />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Tray summary" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="UsageMetric"
                            Margin="0,0,18,0"
                            Checked="TodayMetric_OnChecked"
                            Content="API equivalent"
                            Tag="Usage" />
                        <RadioButton
                            x:Name="TokenMetric"
                            Checked="TodayMetric_OnChecked"
                            Content="Billing tokens"
                            Tag="Token" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Choose the Today value shown in the tray tooltip. The Tokens tab always shows Billing tokens with Estimated API value beneath it. API equivalent uses standard list prices by recorded model; Billing tokens exclude cache reads. Token Kind display toggles change neither summary."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Token values" />
                    <WrapPanel>
                        <RadioButton
                            x:Name="TokenValueMode"
                            Margin="0,0,18,8"
                            Checked="TokenValueDisplay_OnChecked"
                            Content="Value"
                            Tag="Value" />
                        <RadioButton
                            x:Name="TokenPercentageMode"
                            Margin="0,0,18,8"
                            Checked="TokenValueDisplay_OnChecked"
                            Content="Percentage"
                            Tag="Percentage" />
                        <RadioButton
                            x:Name="TokenValuePercentageMode"
                            Margin="0,0,0,8"
                            Checked="TokenValueDisplay_OnChecked"
                            Content="Value (percentage)"
                            Tag="ValueAndPercentage" />
                    </WrapPanel>
                    <TextBlock
                        Style="{StaticResource SecondaryText}"
                        Text="Active Token Kinds use this format. Disabled kinds remain as dimmed raw values and are excluded from composition percentages."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Usage Window style" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            x:Name="DialStyle"
                            Margin="0,0,18,0"
                            Checked="GaugeStyle_OnChecked"
                            Content="Dial"
                            Tag="Dial" />
                        <RadioButton
                            x:Name="RingStyle"
                            Margin="0,0,18,0"
                            Checked="GaugeStyle_OnChecked"
                            Content="Ring"
                            Tag="Ring" />
                        <RadioButton
                            x:Name="BarStyle"
                            Checked="GaugeStyle_OnChecked"
                            Content="Bar"
                            Tag="Bar" />
                    </StackPanel>
                    <Border
                        Margin="0,12,0,0"
                        Padding="14"
                        Style="{StaticResource CardBorder}">
                        <StackPanel x:Name="GaugePreviewPanel" />
                    </Border>

                    <TextBlock Margin="0,22,0,6" Style="{StaticResource SectionTitle}" Text="Windows" />
                    <CheckBox
                        x:Name="AlwaysOnTopCheckBox"
                        Margin="0,0,0,8"
                        Checked="AlwaysOnTop_OnChanged"
                        Unchecked="AlwaysOnTop_OnChanged"
                        Content="Keep the flyout pinned on top" />
                    <CheckBox
                        x:Name="StartWithWindowsCheckBox"
                        Checked="StartWithWindows_OnChanged"
                        Unchecked="StartWithWindows_OnChanged"
                        Content="Start TokenStats when I sign in" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer
                x:Name="AppearancePage"
                Padding="28,24"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Text="Appearance" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Personalize TokenStats independently from Windows while preserving High Contrast accessibility."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Theme" />
                    <ComboBox
                        x:Name="ThemeModeCombo"
                        Width="220"
                        HorizontalAlignment="Left"
                        SelectionChanged="ThemeModeCombo_OnSelectionChanged">
                        <ComboBoxItem Content="Follow Windows" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="High Contrast always follows Windows and temporarily overrides custom colors, images, and flyout transparency."
                        TextWrapping="Wrap" />

                    <Grid Margin="0,22,0,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Theme colors" />
                        <Button
                            x:Name="ResetColorsButton"
                            HorizontalAlignment="Right"
                            Click="ResetColors_OnClick"
                            Content="Reset colors" />
                    </Grid>
                    <UniformGrid
                        x:Name="ColorOverridesPanel"
                        Columns="2"
                        Rows="7" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Choose a swatch to override it. Each override is layered over the selected light or dark palette."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Typography" />
                    <ComboBox
                        x:Name="FontFamilyCombo"
                        Width="320"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectionChanged="FontFamilyCombo_OnSelectionChanged" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Applies to interface text and Usage Window gauges. Icons and aligned token columns keep their specialized fonts."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Background image" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="BackgroundImagePathText"
                            MinWidth="180"
                            IsReadOnly="True"
                            ToolTip="Selected background image" />
                        <Button
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Click="ChooseBackgroundImage_OnClick"
                            Content="Choose…" />
                        <Button
                            x:Name="ClearBackgroundImageButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Click="ClearBackgroundImage_OnClick"
                            Content="Clear" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="Placement" />
                        <ComboBox
                            x:Name="BackgroundPlacementCombo"
                            Grid.Column="1"
                            Width="180"
                            HorizontalAlignment="Left"
                            SelectionChanged="BackgroundPlacementCombo_OnSelectionChanged">
                            <ComboBoxItem Content="Fill" Tag="Fill" />
                            <ComboBoxItem Content="Fit" Tag="Fit" />
                            <ComboBoxItem Content="Center" Tag="Center" />
                            <ComboBoxItem Content="Tile" Tag="Tile" />
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="Position" />
                        <ComboBox
                            x:Name="BackgroundPositionCombo"
                            Grid.Column="1"
                            Width="180"
                            HorizontalAlignment="Left"
                            SelectionChanged="BackgroundPositionCombo_OnSelectionChanged">
                            <ComboBoxItem Content="Top left" Tag="TopLeft" />
                            <ComboBoxItem Content="Top" Tag="Top" />
                            <ComboBoxItem Content="Top right" Tag="TopRight" />
                            <ComboBoxItem Content="Left" Tag="Left" />
                            <ComboBoxItem Content="Center" Tag="Center" />
                            <ComboBoxItem Content="Right" Tag="Right" />
                            <ComboBoxItem Content="Bottom left" Tag="BottomLeft" />
                            <ComboBoxItem Content="Bottom" Tag="Bottom" />
                            <ComboBoxItem Content="Bottom right" Tag="BottomRight" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Text="Opacity" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="BackgroundImageOpacitySlider"
                            Maximum="100"
                            Minimum="0"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Background image opacity"
                            ValueChanged="BackgroundImageOpacity_OnValueChanged" />
                        <TextBlock
                            x:Name="BackgroundImageOpacityValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}" />
                    </Grid>

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Flyout" />
                    <TextBlock Text="Opacity" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="FlyoutOpacitySlider"
                            Maximum="100"
                            Minimum="55"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Flyout opacity"
                            ValueChanged="FlyoutOpacity_OnValueChanged" />
                        <TextBlock
                            x:Name="FlyoutOpacityValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Text="Width" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="FlyoutWidthSlider"
                            Maximum="640"
                            Minimum="360"
                            TickFrequency="20"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Flyout width"
                            ValueChanged="FlyoutWidth_OnValueChanged" />
                        <TextBlock
                            x:Name="FlyoutWidthValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}" />
                    </Grid>

                    <TextBlock Margin="0,22,0,8" Style="{StaticResource SectionTitle}" Text="Interface scale" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            x:Name="InterfaceScaleSlider"
                            Maximum="140"
                            Minimum="80"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            AutomationProperties.Name="Text and interface scale"
                            ValueChanged="InterfaceScale_OnValueChanged" />
                        <TextBlock
                            x:Name="InterfaceScaleValue"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryText}" />
                    </Grid>
                    <TextBlock
                        Margin="0,6,0,0"
                        Style="{StaticResource SecondaryText}"
                        Text="Text, controls, spacing, and window dimensions scale together. Windows DPI scaling remains active."
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,22,0,0"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        Style="{StaticResource CardBorder}">
                        <Grid>
                            <Border
                                Background="{DynamicResource AppBackgroundImageBrush}"
                                IsHitTestVisible="False" />
                            <StackPanel Margin="6">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Live preview" />
                                <TextBlock
                                    Margin="0,3,0,10"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="Typography, surfaces, borders, and token colors"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="8" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}" CornerRadius="4" />
                                    <Border Width="42" Height="8" Margin="0,0,6,0" Background="{DynamicResource TokenInputBrush}" CornerRadius="4" />
                                    <Border Width="42" Height="8" Margin="0,0,6,0" Background="{DynamicResource TokenOutputBrush}" CornerRadius="4" />
                                    <Border Width="42" Height="8" Background="{DynamicResource TokenCacheReadBrush}" CornerRadius="4" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button
                        x:Name="ResetAppearanceButton"
                        Margin="0,18,0,0"
                        HorizontalAlignment="Left"
                        Click="ResetAppearance_OnClick"
                        Content="Reset all appearance settings" />
                </StackPanel>
            </ScrollViewer>

            <Grid
                x:Name="AboutPage"
                Margin="28"
                Visibility="Collapsed">
                <StackPanel
                    Width="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="52"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="&#xE9D9;" />
                    <TextBlock
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Text="TokenStats" />
                    <TextBlock
                        x:Name="VersionText"
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="Version —" />
                    <TextBlock
                        Margin="0,16,0,0"
                        TextAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="A tray gauge for your Coding Agents — see how much of each Usage Window is left and when it resets." />
                    <StackPanel
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Click="ViewOnGitHub_OnClick"
                            Content="View on GitHub" />
                        <Button
                            Click="RunSetupAgain_OnClick"
                            Content="Run setup again" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
