<Window
    x:Class="TokenStats.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Welcome to TokenStats"
    Icon="/TokenStats;component/Assets/TokenStats.ico"
    Width="560"
    Height="620"
    MinWidth="400"
    MinHeight="360"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource PrimaryTextBrush}"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    Style="{StaticResource {x:Type Window}}"
    WindowStartupLocation="CenterScreen">
    <Grid x:Name="AppearanceRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="5"
            Background="{DynamicResource AppBackgroundImageBrush}"
            IsHitTestVisible="False" />

        <StackPanel Margin="28,24,28,18">
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="38"
                Foreground="{DynamicResource AccentBrush}"
                Text="&#xE9D9;" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Text="Welcome to TokenStats" />
            <StackPanel
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Border x:Name="StepDot0" Width="25" Height="6" Margin="4" Background="{DynamicResource AccentBrush}" CornerRadius="3" />
                <Border x:Name="StepDot1" Width="18" Height="6" Margin="4" Background="{DynamicResource BorderBrush}" CornerRadius="3" />
                <Border x:Name="StepDot2" Width="18" Height="6" Margin="4" Background="{DynamicResource BorderBrush}" CornerRadius="3" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

        <ScrollViewer
            Grid.Row="2"
            Padding="30,24"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="DisclosureStep">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Before you start" />
                    <TextBlock
                        Margin="0,5,0,18"
                        Style="{StaticResource SecondaryText}"
                        Text="The next step connects your accounts. Here is exactly what TokenStats accesses." />
                    <Border Margin="0,0,0,10" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Tokens stay in Credential Manager" />
                            <TextBlock
                                Margin="0,3,0,0"
                                MaxWidth="420"
                                Style="{StaticResource SecondaryText}"
                                Text="Browser sign-in creates TokenStats' own credentials. It never reuses the agents' saved login." />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,0,10" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Only Anthropic and OpenAI are contacted" />
                            <TextBlock
                                Margin="0,3,0,0"
                                MaxWidth="420"
                                Style="{StaticResource SecondaryText}"
                                Text="Usage is fetched directly from each Coding Agent. Nothing is sent to a TokenStats server." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Your work stays on this PC" />
                            <TextBlock
                                Margin="0,3,0,0"
                                MaxWidth="420"
                                Style="{StaticResource SecondaryText}"
                                Text="The Token Odometer reads local transcript files and uploads none of their content." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="AccountsStep" Visibility="Collapsed">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Connect your agents" />
                    <TextBlock
                        Margin="0,5,0,18"
                        Style="{StaticResource SecondaryText}"
                        Text="Connect one, both, or neither. You can always do this later in Settings." />
                    <StackPanel x:Name="OnboardingAccountsPanel" />
                    <TextBlock Margin="0,18,0,6" FontWeight="SemiBold" Text="Primary subscription" />
                    <ComboBox
                        x:Name="OnboardingPrimaryCombo"
                        Width="280"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Id"
                        SelectionChanged="OnboardingPrimaryCombo_OnSelectionChanged" />
                </StackPanel>

                <StackPanel
                    x:Name="DoneStep"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="55"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="&#xE73E;" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Text="You're all set" />
                    <Border Margin="0,24,0,0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock x:Name="ConnectedSummary" Text="No agents connected yet" />
                            <TextBlock x:Name="PrimarySummary" Margin="0,8,0,0" Text="Primary: Claude Code" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="0,18,0,0"
                        TextAlignment="Center"
                        Style="{StaticResource SecondaryText}"
                        Text="TokenStats now lives in the Windows notification area. Revisit setup anytime from Settings." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />

        <Grid Grid.Row="4" Margin="24,14">
            <Button
                HorizontalAlignment="Left"
                Background="Transparent"
                BorderThickness="0"
                Click="SkipButton_OnClick"
                Content="Skip" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="BackButton"
                    Margin="0,0,8,0"
                    Click="BackButton_OnClick"
                    Content="Back"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ContinueButton"
                    MinWidth="92"
                    IsDefault="True"
                    Style="{StaticResource AccentButton}"
                    Click="ContinueButton_OnClick"
                    Content="Continue" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
