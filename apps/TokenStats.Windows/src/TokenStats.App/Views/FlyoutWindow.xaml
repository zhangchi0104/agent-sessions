<Window
    x:Class="TokenStats.App.Views.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:TokenStats.App.Controls"
    Title="TokenStats"
    Width="424"
    MaxHeight="760"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SizeChanged="FlyoutWindow_OnSizeChanged"
    Style="{StaticResource {x:Type Window}}"
    WindowStyle="None">
    <Border
        x:Name="AppearanceRoot"
        Margin="12"
        Background="{DynamicResource WindowBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="22"
                Direction="270"
                Opacity="0.24"
                ShadowDepth="5"
                Color="#70000000" />
        </Border.Effect>
        <Grid>
            <Border
                Background="{DynamicResource AppBackgroundImageBrush}"
                CornerRadius="13"
                IsHitTestVisible="False" />
            <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="TokenStats" />
                <ToggleButton
                    x:Name="PinButton"
                    Grid.Column="1"
                    Style="{StaticResource IconToggleButton}"
                    ToolTip="Keep flyout on top"
                    AutomationProperties.Name="Keep flyout on top"
                    Checked="PinButton_OnChanged"
                    Unchecked="PinButton_OnChanged"
                    Content="&#xE718;" />
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    ToolTip="Refresh all (Ctrl+R)"
                    AutomationProperties.Name="Refresh all"
                    Click="RefreshButton_OnClick"
                    Content="&#xE72C;" />
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,0,0,12"
                Padding="3"
                Background="{DynamicResource SubtleBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton
                        x:Name="UsageTabButton"
                        Grid.Column="0"
                        Style="{StaticResource TopTabButton}"
                        GroupName="FlyoutTopTab"
                        AutomationProperties.Name="Usage tab"
                        Checked="UsageTabButton_OnChecked"
                        Content="Usage" />
                    <RadioButton
                        x:Name="TokensTabButton"
                        Grid.Column="1"
                        Style="{StaticResource TopTabButton}"
                        GroupName="FlyoutTopTab"
                        AutomationProperties.Name="Tokens tab"
                        Checked="TokensTabButton_OnChecked"
                        Content="Tokens" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer
                    x:Name="UsageContentScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AgentsPanel" />
                </ScrollViewer>

                <ScrollViewer
                    x:Name="TokensContentScroll"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,4,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryText}"
                                Text="Reporting range" />
                            <ComboBox
                                x:Name="TokenRangeComboBox"
                                Grid.Column="1"
                                Width="112"
                                AutomationProperties.Name="Reporting range"
                                SelectedValuePath="Tag"
                                SelectionChanged="TokenRangeComboBox_OnSelectionChanged">
                                <ComboBoxItem Content="Today" Tag="Today" />
                                <ComboBoxItem Content="7 days" Tag="SevenDays" />
                                <ComboBoxItem Content="30 days" Tag="ThirtyDays" />
                            </ComboBox>
                        </Grid>

                        <Border
                            x:Name="TokenSummaryPanel"
                            Margin="0,0,0,18"
                            Background="Transparent"
                            ToolTipService.ShowDuration="30000">
                            <StackPanel>
                                <controls:RollingNumberText
                                    x:Name="TokenSummaryValue"
                                    FontFamily="{DynamicResource AppFontFamily}"
                                    FontSize="38"
                                    FontWeight="Bold"
                                    Focusable="False"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    IsTabStop="False"
                                    Text="—" />
                                <TextBlock
                                    x:Name="TokenSummaryLabel"
                                    Margin="1,-2,0,0"
                                    Style="{StaticResource SecondaryText}"
                                    Text="Billing tokens · Today" />
                                <Grid
                                    x:Name="ApiEstimatePanel"
                                    Margin="1,10,0,0"
                                    ToolTipService.ShowDuration="30000">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource SecondaryText}"
                                        Text="Estimated API value" />
                                    <TextBlock
                                        x:Name="ApiEstimateValue"
                                        Grid.Column="1"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        Text="—" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="By agent and model" />
                                <TextBlock
                                    x:Name="TokenTableTotal"
                                    Margin="0,1,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="—" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="OdometerStatusText"
                                    HorizontalAlignment="Right"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ProgressBar
                                    x:Name="OdometerProgress"
                                    Width="62"
                                    Height="3"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Right"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="TokenTablePanel">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="MODEL" />
                                <ToggleButton
                                    x:Name="DirectInputKindButton"
                                    Grid.Column="1"
                                    Style="{StaticResource TokenKindToggleButton}"
                                    Tag="DirectInput"
                                    ToolTip="Include direct input in the selected total"
                                    AutomationProperties.Name="Include direct input tokens"
                                    Checked="TokenKindButton_OnChanged"
                                    Unchecked="TokenKindButton_OnChanged">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TokenInputBrush}" />
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TokenInputBrush}"
                                            Text="IN" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="OutputKindButton"
                                    Grid.Column="2"
                                    Style="{StaticResource TokenKindToggleButton}"
                                    Tag="Output"
                                    ToolTip="Include output in the selected total"
                                    AutomationProperties.Name="Include output tokens"
                                    Checked="TokenKindButton_OnChanged"
                                    Unchecked="TokenKindButton_OnChanged">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TokenOutputBrush}" />
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TokenOutputBrush}"
                                            Text="OUT" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    x:Name="CacheReadKindButton"
                                    Grid.Column="3"
                                    Style="{StaticResource TokenKindToggleButton}"
                                    Tag="CacheRead"
                                    ToolTip="Include cache read in the selected total"
                                    AutomationProperties.Name="Include cache read tokens"
                                    Checked="TokenKindButton_OnChanged"
                                    Unchecked="TokenKindButton_OnChanged">
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Border
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TokenCacheReadBrush}" />
                                        <TextBlock
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TokenCacheReadBrush}"
                                            Text="C·R" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                            <StackPanel x:Name="TokenRowsPanel" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource BorderBrush}" />
                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SettingsButton"
                        Style="{StaticResource IconButton}"
                        ToolTip="Settings (Ctrl+,)"
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_OnClick"
                        Content="&#xE713;" />
                </StackPanel>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
