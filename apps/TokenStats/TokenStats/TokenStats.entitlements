<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TokenStats ships as a notarized, NON-sandboxed Developer ID menu-bar
	     app. It reads agent transcripts and the shared agent-sessions SQLite
	     database from arbitrary home-relative paths (~/.claude, ~/.codex,
	     ~/.local/agent-sessions), which App Sandbox cannot grant without a
	     provisioning profile. The sandbox "temporary-exception" entitlements we
	     used before are RESTRICTED entitlements: with no embedded provisioning
	     profile, AMFI SIGKILLs the app at launch (codesign/spctl/notarization
	     don't catch this — only the runtime kernel does). So we run without the
	     sandbox (ENABLE_APP_SANDBOX = NO) and request no restricted entitlements.
	     Keychain access uses the default team-based access group. -->
</dict>
</plist>
