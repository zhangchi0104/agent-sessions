    "settings.about.description": {
      "comment": "One-sentence description of TokenStats. Coding Agent and Usage Window are product terms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A menu-bar gauge for your Coding Agents — see how much of each Usage Window is left and when it resets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏中的 Coding Agent 用量仪表，可查看各个用量周期的剩余量和重置时间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Anzeige in der Menüleiste für Ihre Coding Agents – sehen Sie, wie viel von jedem Nutzungszeitraum verbleibt und wann er zurückgesetzt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indicateur dans la barre des menus pour vos Coding Agents : consultez la part restante de chaque fenêtre d’utilisation et l’heure de sa réinitialisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding Agent の各使用期間の残量とリセット時刻を確認できる、メニューバーのゲージです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Индикатор в строке меню для Coding Agent: показывает остаток каждого периода использования и время его сброса."
          }
        }
      }
    },
