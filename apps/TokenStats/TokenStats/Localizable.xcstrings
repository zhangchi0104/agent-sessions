    "settings.tokens.currency.status.refreshing_with_last_known": {
      "comment": "Status shown while refreshing when a last-known rate remains usable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing rates; the last known rate remains in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在刷新汇率；仍继续使用上次已知汇率。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurse werden aktualisiert; der zuletzt bekannte Kurs bleibt in Verwendung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les taux sont en cours d’actualisation ; le dernier taux connu reste utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートを更新中です。前回取得したレートを引き続き使用します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсы обновляются; используется последний известный курс."
          }
        }
      }
    },
    "settings.tokens.currency.status.retry_without_cache": {
      "comment": "Retry explanation after a failed request when no cached rates exist.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry now to request rates again. This sends one additional request before the next scheduled update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重试以再次请求汇率。这会在下次计划更新前额外发送一次请求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es jetzt erneut, um die Kurse erneut anzufordern. Dadurch wird vor der nächsten geplanten Aktualisierung eine zusätzliche Anfrage gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez maintenant pour demander de nouveau les taux. Cela envoie une requête supplémentaire avant la prochaine actualisation planifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ再試行すると、レートを再度リクエストします。これにより、次回の予定更新前に追加のリクエストが1回送信されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите попытку сейчас, чтобы снова запросить курсы. До следующего планового обновления будет отправлен один дополнительный запрос."
          }
        }
      }
    },
    "settings.tokens.currency.status.retry_with_cache": {
      "comment": "Retry explanation after a failed request when cached rates remain usable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last known rate remains in use. Retry now to request rates again; this sends one additional request before the next scheduled update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍继续使用上次已知汇率。立即重试可再次请求汇率；这会在下次计划更新前额外发送一次请求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der zuletzt bekannte Kurs bleibt in Verwendung. Versuchen Sie es jetzt erneut, um die Kurse erneut anzufordern; dadurch wird vor der nächsten geplanten Aktualisierung eine zusätzliche Anfrage gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dernier taux connu reste utilisé. Réessayez maintenant pour demander de nouveau les taux ; cela envoie une requête supplémentaire avant la prochaine actualisation planifiée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回取得したレートを引き続き使用します。今すぐ再試行するとレートを再度リクエストし、次回の予定更新前に追加のリクエストが1回送信されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется последний известный курс. Повторите попытку сейчас, чтобы снова запросить курсы; до следующего планового обновления будет отправлен один дополнительный запрос."
          }
        }
      }
    },
