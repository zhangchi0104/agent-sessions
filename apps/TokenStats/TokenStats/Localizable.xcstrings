    "onboarding.accounts.primary_subscription.footer": {
      "comment": "Explains how the selected primary subscription is presented.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown first and badged in the popover and menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在弹出窗口和菜单栏中置顶显示并标记。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Popover und in der Menüleiste an erster Stelle und mit einer Kennzeichnung angezeigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiché en premier et marqué d’un badge dans la fenêtre contextuelle et la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポップオーバーとメニューバーの先頭に表示され、バッジが付きます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается первым и отмечается значком во всплывающем окне и строке меню."
          }
        }
      }
    },
    "onboarding.accounts.primary_subscription.title": {
      "comment": "Label for choosing which Coding Agent subscription is presented first.",
