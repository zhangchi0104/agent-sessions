    "settings.general.language.restart.message": {
      "comment": "Prompt explaining that the saved application language requires a restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart TokenStats now to apply the new language, or continue using the current language until later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即重启 TokenStats 以应用新语言，或继续使用当前语言并稍后重启。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie TokenStats jetzt neu, um die neue Sprache anzuwenden, oder verwenden Sie bis zu einem späteren Neustart weiterhin die aktuelle Sprache."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redémarrez TokenStats maintenant pour appliquer la nouvelle langue, ou continuez à utiliser la langue actuelle et redémarrez plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい言語を適用するには TokenStats を今すぐ再起動してください。または、現在の言語を使い続けて後で再起動できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезапустите TokenStats сейчас, чтобы применить новый язык, или продолжайте использовать текущий язык и перезапустите позже."
          }
        }
      }
    },
    "settings.general.language.restart.now": {
      "comment": "Button that immediately restarts TokenStats to apply a language change.",
      "extractionState": "manual",
      "localizations": {
        "en": {
