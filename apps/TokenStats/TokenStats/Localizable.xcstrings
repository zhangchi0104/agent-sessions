    "settings.tokens.currency.provider.frankfurter.explanation": {
      "comment": "Explanation of the Frankfurter rate provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broad daily reference-rate coverage from multiple public providers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供来自多个公共数据提供方的广泛每日参考汇率。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite Abdeckung täglicher Referenzkurse aus mehreren öffentlichen Quellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Large couverture de taux de référence quotidiens provenant de plusieurs fournisseurs publics."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数の公開プロバイダによる、幅広い通貨を対象とした日次参照レートです。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий охват ежедневных справочных курсов от нескольких общедоступных поставщиков."
          }
        }
      }
    },
    "settings.tokens.currency.provider.exchange_rate_api.explanation": {
      "comment": "Explanation of the ExchangeRate-API Open provider.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A keyless daily USD table; attribution is required by the service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供无需密钥的每日 USD 汇率表；该服务要求标注来源。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine tägliche USD-Tabelle ohne API-Schlüssel; der Dienst verlangt eine Quellenangabe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une table quotidienne basée sur l’USD, sans clé API ; le service exige une attribution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キー不要の日次 USD レート表です。サービスの利用には帰属表示が必要です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневная таблица курсов относительно USD без ключа; сервис требует указания источника."
          }
        }
      }
    },
    "settings.tokens.currency.provider.ecb.explanation": {
      "comment": "Explanation of the European Central Bank adapter.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official EUR reference rates converted once into USD cross-rates; coverage is limited to currencies published for the latest ECB date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将官方 EUR 参考汇率一次换算为 USD 交叉汇率；仅覆盖欧洲中央银行在最新日期发布的货币。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offizielle EUR-Referenzkurse, einmal in USD-Kreuzkurse umgerechnet; abgedeckt sind nur Währungen, die für den jüngsten EZB-Stichtag veröffentlicht wurden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taux de référence officiels en EUR, convertis une seule fois en taux croisés basés sur l’USD ; seules les devises publiées pour la dernière date de la BCE sont couvertes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欧州中央銀行の公式 EUR 参照レートを一度だけ USD クロスレートに換算します。対象は、ECB の最新レート日に公表された通貨に限られます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Официальные справочные курсы относительно EUR, однократно пересчитанные в кросс-курсы относительно USD; доступны только валюты, опубликованные ЕЦБ на последнюю дату."
          }
        }
      }
    },
