          "stringUnit": {
            "state": "translated",
            "value": "Источник данных"
          }
        }
      }
    },
    "settings.tokens.currency.details.request_policy": {
      "comment": "Footer explaining the USD pricing basis, 24-hour automatic request limit, and explicit retry behavior.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official Model prices remain in USD. TokenStats downloads a complete USD reference-rate table from the selected provider automatically at most once every 24 hours. Retrying after an error sends one additional request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方模型价格仍以 USD 计价。TokenStats 每 24 小时最多自动从所选提供商下载一次完整的 USD 参考汇率表。发生错误后重试会额外发送一次请求。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offiziellen Modellpreise bleiben in USD. TokenStats lädt höchstens einmal alle 24 Stunden automatisch eine vollständige USD-Referenzkurstabelle vom ausgewählten Anbieter herunter. Bei einem erneuten Versuch nach einem Fehler wird eine zusätzliche Anfrage gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tarifs officiels des modèles restent libellés en USD. TokenStats télécharge automatiquement une table complète de taux de référence basés sur l’USD auprès du fournisseur sélectionné, au maximum une fois toutes les 24 heures. Réessayer après une erreur envoie une requête supplémentaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式のモデル価格は引き続き USD 建てです。TokenStats は、選択したプロバイダから USD 基準の完全な為替レート表を24時間に最大1回、自動的にダウンロードします。エラー後に再試行すると、追加のリクエストが1回送信されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Официальные цены моделей остаются в USD. TokenStats автоматически загружает у выбранного поставщика полную таблицу справочных курсов относительно USD не чаще одного раза в 24 часа. Повторная попытка после ошибки отправляет один дополнительный запрос."
          }
        }
      }
    },
    "settings.tokens.currency.status.updating_rates": {
      "comment": "Compact status shown while exchange rates are updating.",
      "extractionState": "manual",
      "localizations": {
