    "account.status.awaiting_code": {
      "comment": "Status label while waiting for the user to paste an OAuth code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待授权码"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Code"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを待機中"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание кода"
          }
        }
      }
    },
    "account.status.connected": {
      "comment": "Status label for a connected Coding Agent account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
