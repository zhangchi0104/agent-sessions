    "tokens.summary.billing.help": {
      "comment": "Detailed billing-token help. The first argument is the exact billing Token count and drives pluralization; the remaining arguments are localized counts for direct input, output, and cache read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld billing token. Direct input %2$@ · Output %3$@ · Cache read %4$@. Billing tokens include direct input and output; cache reads remain visible in the table but are excluded from this total. Token Kind filters do not change this summary."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld billing tokens. Direct input %2$@ · Output %3$@ · Cache read %4$@. Billing tokens include direct input and output; cache reads remain visible in the table but are excluded from this total. Token Kind filters do not change this summary."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld 个计费 Token。直接输入 %2$@ · 输出 %3$@ · 缓存读取 %4$@。计费 Token 包含直接输入和输出；缓存读取仍显示在表格中，但不计入此合计。Token 类型筛选不会改变此摘要。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld 个计费 Token。直接输入 %2$@ · 输出 %3$@ · 缓存读取 %4$@。计费 Token 包含直接输入和输出；缓存读取仍显示在表格中，但不计入此合计。Token 类型筛选不会改变此摘要。"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Abrechnungs-Token. Direkte Eingabe %2$@ · Ausgabe %3$@ · Cache-Lesevorgänge %4$@. Abrechnungs-Token umfassen direkte Eingaben und Ausgaben; Cache-Lesevorgänge bleiben in der Tabelle sichtbar, werden aber nicht in diese Summe einbezogen. Filter für Token-Typen ändern diese Zusammenfassung nicht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Abrechnungs-Token. Direkte Eingabe %2$@ · Ausgabe %3$@ · Cache-Lesevorgänge %4$@. Abrechnungs-Token umfassen direkte Eingaben und Ausgaben; Cache-Lesevorgänge bleiben in der Tabelle sichtbar, werden aber nicht in diese Summe einbezogen. Filter für Token-Typen ändern diese Zusammenfassung nicht."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld token facturable. Entrée directe %2$@ · Sortie %3$@ · Lecture du cache %4$@. Les tokens facturables comprennent les entrées directes et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tokens facturables. Entrée directe %2$@ · Sortie %3$@ · Lecture du cache %4$@. Les tokens facturables comprennent les entrées directes et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tokens facturables. Entrée directe %2$@ · Sortie %3$@ · Lecture du cache %4$@. Les tokens facturables comprennent les entrées directes et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "課金対象トークン数：%1$lld。直接入力 %2$@ · 出力 %3$@ · キャッシュ読み取り %4$@。課金対象トークンには直接入力と出力が含まれます。キャッシュ読み取りは表に表示されますが、この合計には含まれません。トークン種別フィルタはこの概要に影響しません。"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётный токен. Прямой ввод %2$@ · Вывод %3$@ · Чтение кэша %4$@. Расчётные токены включают прямой ввод и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётных токена. Прямой ввод %2$@ · Вывод %3$@ · Чтение кэша %4$@. Расчётные токены включают прямой ввод и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётных токенов. Прямой ввод %2$@ · Вывод %3$@ · Чтение кэша %4$@. Расчётные токены включают прямой ввод и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётного токена. Прямой ввод %2$@ · Вывод %3$@ · Чтение кэша %4$@. Расчётные токены включают прямой ввод и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              }
            }
          }
        }
      }
    },
