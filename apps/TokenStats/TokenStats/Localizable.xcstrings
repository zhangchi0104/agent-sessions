    "settings.appearance.order.reorder.accessibility_hint": {
      "comment": "Accessibility hint for a Coding Agent row that can be reordered by dragging.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draggable. Drag to reorder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可拖动。拖动以重新排序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehbar. Ziehen Sie, um die Reihenfolge zu ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Élément déplaçable. Faites-le glisser pour réorganiser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグできます。ドラッグして並べ替えてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно перетаскивать. Перетащите, чтобы изменить порядок."
          }
        }
      }
    },
    "settings.appearance.order.reorderable.footer": {
      "comment": "Instructions shown when there are enough Coding Agent subscriptions to reorder.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to arrange how subscriptions are listed. The primary subscription always leads."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以调整订阅的排列顺序。主要订阅始终位于首位。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die Abonnements in die gewünschte Reihenfolge. Das primäre Abonnement steht immer an erster Stelle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les abonnements pour définir leur ordre. L’abonnement principal reste toujours en tête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグしてサブスクリプションの表示順を変更します。メインのサブスクリプションは常に先頭です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетаскивайте подписки, чтобы изменить порядок. Основная подписка всегда идёт первой."
          }
        }
      }
    },
