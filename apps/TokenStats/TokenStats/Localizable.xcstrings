    "onboarding.done.footer": {
      "comment": "Final onboarding note explaining where TokenStats lives and how to reopen setup. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats lives in your menu bar. You can reconnect agents or revisit this setup anytime from Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 位于菜单栏中。你可以随时在“设置”中重新连接 Coding Agent 或再次进行设置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats befindet sich in Ihrer Menüleiste. Sie können Coding Agents jederzeit erneut verbinden oder diese Einrichtung in den Einstellungen wieder aufrufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats se trouve dans la barre des menus. Vous pouvez reconnecter vos Coding Agents ou reprendre cette configuration à tout moment depuis Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats はメニューバーに常駐します。Coding Agent の再接続やこの設定のやり直しは、いつでも「設定」から行えます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats находится в строке меню. Подключить Coding Agent заново или вернуться к настройке можно в любое время в Настройках."
          }
        }
      }
    },
