          }
        }
      }
    },
    "settings.general.language.restart.error.application_unavailable": {
      "comment": "Error shown when TokenStats cannot determine the application URL needed to restart.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats could not locate its application. Quit and reopen it manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 无法定位应用程序。请手动退出并重新打开。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats konnte die zugehörige App nicht finden. Beenden Sie TokenStats und öffnen Sie die App manuell erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats n’a pas pu localiser l’app à redémarrer. Quittez TokenStats et rouvrez l’app manuellement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats アプリが見つかりませんでした。手動で終了して、もう一度開いてください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось определить расположение приложения TokenStats. Завершите TokenStats и откройте приложение снова вручную."
          }
        }
      }
    },
    "settings.general.language.restart.error.launch_failed": {
      "comment": "Error shown when launching the replacement app instance fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats could not restart. This instance is still running."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 无法重启。当前实例仍在运行。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats konnte nicht neu gestartet werden. Diese Instanz wird weiterhin ausgeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats n’a pas pu redémarrer. Cette instance est toujours en cours d’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats を再起動できませんでした。このインスタンスは引き続き実行中です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось перезапустить TokenStats. Этот экземпляр продолжает работать."
          }
        }
      }
    },
