{
  "sourceLanguage": "en",
  "strings": {
    "account.sign_in.agent.button": {
      "comment": "Button that starts sign-in. The argument is an unlocalized Coding Agent brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei %@ anmelden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se connecter à %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にサインイン"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войти в %@"
          }
        }
      }
    },
    "account.sign_in.automatic.instruction": {
      "comment": "Instruction shown during a self-completing browser OAuth flow. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve in your browser; TokenStats finishes automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中授权；TokenStats 将自动完成登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie die Anfrage in Ihrem Browser; TokenStats schließt die Anmeldung automatisch ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez la demande dans votre navigateur ; TokenStats terminera automatiquement la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで承認してください。TokenStats が自動的にサインインを完了します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите доступ в браузере; TokenStats завершит вход автоматически."
          }
        }
      }
    },
    "account.sign_in.callback.failure.body": {
      "comment": "Body on a failed OAuth callback page. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No authorization code was found. Return to TokenStats and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到授权码。请返回 TokenStats 后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Autorisierungscode gefunden. Kehren Sie zu TokenStats zurück und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun code d’autorisation n’a été trouvé. Revenez à TokenStats et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認可コードが見つかりませんでした。TokenStats に戻って、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код авторизации не найден. Вернитесь в TokenStats и попробуйте ещё раз."
          }
        }
      }
    },
    "account.sign_in.callback.failure.heading": {
      "comment": "Heading on a failed OAuth browser callback page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに失敗しました"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка входа"
          }
        }
      }
    },
    "account.sign_in.callback.success.body": {
      "comment": "Body on the successful OAuth callback page. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this tab and return to TokenStats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以关闭此标签页并返回 TokenStats。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können diesen Tab schließen und zu TokenStats zurückkehren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez fermer cet onglet et revenir à TokenStats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタブを閉じて TokenStats に戻ることができます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно закрыть эту вкладку и вернуться в TokenStats."
          }
        }
      }
    },
    "account.sign_in.callback.success.heading": {
      "comment": "Heading on the successful Codex OAuth browser callback page. Codex is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in to Codex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 Codex"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Codex angemeldet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté à Codex"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex にサインインしました"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в Codex выполнен"
          }
        }
      }
    },
    "account.sign_in.error.authorization": {
      "comment": "OAuth authorization failure diagnostic. The argument is raw provider detail and must not be translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权失败：%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisierung fehlgeschlagen: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’autorisation : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認可に失敗しました：%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось авторизоваться: %@"
          }
        }
      }
    },
    "account.sign_in.error.cancelled": {
      "comment": "OAuth error when the loopback listener is cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已取消。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde abgebrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインがキャンセルされました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход отменён."
          }
        }
      }
    },
    "account.sign_in.error.local_port": {
      "comment": "OAuth error when TokenStats cannot bind a loopback port.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open a local port for sign-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开用于登录的本地端口。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein lokaler Port für die Anmeldung geöffnet werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’ouvrir un port local pour la connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン用のローカルポートを開けませんでした。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть локальный порт для входа."
          }
        }
      }
    },
    "account.sign_in.error.malformed_redirect": {
      "comment": "OAuth error when the browser callback request is malformed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in redirect was malformed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录重定向格式有误。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weiterleitung zur Anmeldung war fehlerhaft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La redirection de connexion était incorrecte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインのリダイレクトが不正です。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некорректное перенаправление при входе."
          }
        }
      }
    },
    "account.sign_in.error.missing_refresh_token": {
      "comment": "OAuth error when the provider omits the refresh token needed to keep the account signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in did not return a refresh token; cannot stay signed in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录未返回刷新 Token，无法保持登录状态。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung wurde kein Refresh-Token zurückgegeben; eine dauerhafte Anmeldung ist nicht möglich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion n’a pas renvoyé de token d’actualisation ; impossible de rester connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインでリフレッシュトークンが返されなかったため、サインイン状態を維持できません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе не получен токен обновления, поэтому оставаться в системе невозможно."
          }
        }
      }
    },
    "account.sign_in.error.state_mismatch": {
      "comment": "OAuth error when the returned state does not match the generated state.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State mismatch — possible interference; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态不匹配——可能受到干扰，请重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sicherheitsparameter stimmt nicht überein – möglicherweise liegt ein Eingriff vor. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état ne correspond pas — une interférence est possible ; réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態が一致しません。外部から干渉された可能性があります。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр состояния не совпадает — возможно вмешательство. Попробуйте ещё раз."
          }
        }
      }
    },
    "account.sign_in.error.timed_out": {
      "comment": "OAuth error when browser approval does not finish before the timeout.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in timed out. Approve in the browser, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录超时。请在浏览器中授权后重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Anmeldung. Bestätigen Sie sie im Browser und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Approuvez la demande dans le navigateur, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインがタイムアウトしました。ブラウザで承認してから、もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания входа истекло. Подтвердите доступ в браузере и попробуйте ещё раз."
          }
        }
      }
    },
    "account.sign_in.error.pasted_code_unsupported": {
      "comment": "Internal sign-in error shown if a paste-code completion is requested for an agent whose OAuth flow does not accept pasted codes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Coding Agent does not sign in with a pasted code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Coding Agent 不使用粘贴授权码的方式登录。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Coding Agent unterstützt keine Anmeldung mit einem eingefügten Code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Coding Agent ne permet pas de se connecter à l’aide d’un code collé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Coding Agent は、貼り付けたコードではサインインできません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Coding Agent не поддерживает вход с помощью вставленного кода."
          }
        }
      }
    },
    "account.sign_in.failed.summary": {
      "comment": "User-facing sign-in failure summary. Raw provider details are kept in diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败，请重试。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに失敗しました。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти. Попробуйте ещё раз."
          }
        }
      }
    },
    "account.sign_in.paste_code.field": {
      "comment": "Placeholder for the OAuth code text field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴授权码"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code einfügen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller le code"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを貼り付け"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте код"
          }
        }
      }
    },
    "account.sign_in.paste_code.instruction": {
      "comment": "Instruction shown during a paste-code OAuth flow. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve TokenStats in your browser, then paste the code here:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中授权 TokenStats，然后将授权码粘贴到此处："
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisieren Sie TokenStats in Ihrem Browser und fügen Sie anschließend den Code hier ein:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez TokenStats dans votre navigateur, puis collez le code ici :"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで TokenStats を承認し、コードをここに貼り付けてください："
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите доступ TokenStats в браузере, затем вставьте код сюда:"
          }
        }
      }
    },
    "account.sign_in.reopen_browser.button": {
      "comment": "Button that reopens the browser during an OAuth sign-in flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-open browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
