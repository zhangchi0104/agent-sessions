      "comment": "Privacy note below the account controls. TokenStats is the app name and Keychain is Apple's credential store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats stores each account's tokens in your Keychain and never sends them anywhere else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 会将每个账户的 Token 保存在钥匙串中，绝不会发送到其他位置。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats speichert die Token jedes Kontos in Ihrem Schlüsselbund und sendet sie niemals an einen anderen Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats stocke les tokens de chaque compte dans votre trousseau et ne les envoie jamais ailleurs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats は各アカウントのトークンをキーチェーンに保存し、他の場所には送信しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats хранит токены каждой учётной записи в Связке ключей и никуда больше их не отправляет."
          }
        }
      }
    },
