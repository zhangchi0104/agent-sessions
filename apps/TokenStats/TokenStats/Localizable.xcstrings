      }
    },
    "tokens.summary.api_equivalent.exact.help": {
      "comment": "API-equivalent help headed by displayed localized cost and original localized USD cost, followed by the complete localized methodology sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayed estimate %1$@. Original USD estimate %2$@. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示的估算为 %1$@。原始 USD 估算为 %2$@。%3$@"
          }
        },
        "de": {
          "stringUnit": {
