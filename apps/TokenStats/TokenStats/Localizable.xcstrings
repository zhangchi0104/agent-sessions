    "settings.appearance.order.fixed.footer": {
      "comment": "Explanation shown when only two Coding Agent subscriptions exist and reordering would have no effect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to arrange yet — your primary leads and the only other subscription follows. Drag-to-reorder unlocks once you track a third."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无需排序——主要订阅位于首位，另一个订阅紧随其后。添加第三个订阅后即可拖动排序。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit gibt es nichts anzuordnen – Ihr primäres Abonnement steht an erster Stelle, gefolgt vom einzigen weiteren Abonnement. Sobald ein drittes Abonnement hinzukommt, können Sie die Reihenfolge durch Ziehen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à organiser pour le moment : votre abonnement principal est en tête et le seul autre le suit. Le glisser-déposer sera disponible dès que vous en suivrez un troisième."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ並べ替える必要はありません。メインのサブスクリプションが先頭で、もう1つがその後に続きます。3つ目を追加すると、ドラッグして並べ替えられるようになります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока упорядочивать нечего: основная подписка идёт первой, а за ней — единственная другая подписка. Перетаскивание станет доступно после добавления третьей."
          }
        }
      }
    },
