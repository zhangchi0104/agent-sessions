    "settings.appearance.token_summary.footer": {
      "comment": "Explains the Billing tokens and API equivalent summary choices. Model and Token Kind are product terms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billing tokens count direct input, cache writes, and output. API equivalent estimates standard list-price cost from the Models recorded in local transcripts. Token Kind filters change neither summary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计费 Token 包含直接输入、缓存写入和输出。API 等值费用根据本地对话记录中的模型，按标准公开价格进行估算。Token 类型筛选不会改变任一摘要。"
          }
        }
      }
    },
