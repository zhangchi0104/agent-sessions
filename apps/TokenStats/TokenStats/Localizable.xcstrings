    "tokens.summary.billing.help": {
      "comment": "Detailed billing-token help. The first argument is the exact billing Token count and drives pluralization; the remaining arguments are localized counts for direct input, cache write, output, and cache read.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld billing token. Direct input %2$@ · Cache write %3$@ · Output %4$@ · Cache read %5$@. Billing tokens include direct input, cache writes, and output; cache reads remain visible in the table but are excluded from this total. Token Kind filters do not change this summary."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld billing tokens. Direct input %2$@ · Cache write %3$@ · Output %4$@ · Cache read %5$@. Billing tokens include direct input, cache writes, and output; cache reads remain visible in the table but are excluded from this total. Token Kind filters do not change this summary."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld 个计费 Token。直接输入 %2$@ · 缓存写入 %3$@ · 输出 %4$@ · 缓存读取 %5$@。计费 Token 包含直接输入、缓存写入和输出；缓存读取仍显示在表格中，但不计入此合计。Token 类型筛选不会改变此摘要。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld 个计费 Token。直接输入 %2$@ · 缓存写入 %3$@ · 输出 %4$@ · 缓存读取 %5$@。计费 Token 包含直接输入、缓存写入和输出；缓存读取仍显示在表格中，但不计入此合计。Token 类型筛选不会改变此摘要。"
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Abrechnungs-Token. Direkte Eingabe %2$@ · Cache-Schreibvorgänge %3$@ · Ausgabe %4$@ · Cache-Lesevorgänge %5$@. Abrechnungs-Token umfassen direkte Eingaben, Cache-Schreibvorgänge und Ausgaben; Cache-Lesevorgänge bleiben in der Tabelle sichtbar, werden aber nicht in diese Summe einbezogen. Filter für Token-Typen ändern diese Zusammenfassung nicht."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld Abrechnungs-Token. Direkte Eingabe %2$@ · Cache-Schreibvorgänge %3$@ · Ausgabe %4$@ · Cache-Lesevorgänge %5$@. Abrechnungs-Token umfassen direkte Eingaben, Cache-Schreibvorgänge und Ausgaben; Cache-Lesevorgänge bleiben in der Tabelle sichtbar, werden aber nicht in diese Summe einbezogen. Filter für Token-Typen ändern diese Zusammenfassung nicht."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld token facturable. Entrée directe %2$@ · Écriture en cache %3$@ · Sortie %4$@ · Lecture du cache %5$@. Les tokens facturables comprennent les entrées directes, les écritures en cache et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tokens facturables. Entrée directe %2$@ · Écriture en cache %3$@ · Sortie %4$@ · Lecture du cache %5$@. Les tokens facturables comprennent les entrées directes, les écritures en cache et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld tokens facturables. Entrée directe %2$@ · Écriture en cache %3$@ · Sortie %4$@ · Lecture du cache %5$@. Les tokens facturables comprennent les entrées directes, les écritures en cache et les sorties ; les lectures du cache restent visibles dans le tableau, mais sont exclues de ce total. Les filtres de type de token ne modifient pas ce résumé."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "課金対象トークン数：%1$lld。直接入力 %2$@ · キャッシュ書き込み %3$@ · 出力 %4$@ · キャッシュ読み取り %5$@。課金対象トークンには直接入力、キャッシュ書き込み、出力が含まれます。キャッシュ読み取りは表に表示されますが、この合計には含まれません。トークン種別フィルタはこの概要に影響しません。"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётный токен. Прямой ввод %2$@ · Запись в кэш %3$@ · Вывод %4$@ · Чтение кэша %5$@. Расчётные токены включают прямой ввод, запись в кэш и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётных токена. Прямой ввод %2$@ · Запись в кэш %3$@ · Вывод %4$@ · Чтение кэша %5$@. Расчётные токены включают прямой ввод, запись в кэш и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётных токенов. Прямой ввод %2$@ · Запись в кэш %3$@ · Вывод %4$@ · Чтение кэша %5$@. Расчётные токены включают прямой ввод, запись в кэш и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld расчётного токена. Прямой ввод %2$@ · Запись в кэш %3$@ · Вывод %4$@ · Чтение кэша %5$@. Расчётные токены включают прямой ввод, запись в кэш и вывод; чтение кэша остаётся видимым в таблице, но не входит в этот итог. Фильтры типов токенов не меняют этот итог."
                }
