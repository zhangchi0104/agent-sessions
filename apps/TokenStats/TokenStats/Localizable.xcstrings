    "settings.appearance.token_summary.footer": {
      "comment": "Explains the Billing tokens and API equivalent summary choices. Model and Token Kind are product terms.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Billing tokens count direct input and output. API equivalent estimates standard list-price cost from the Models recorded in local transcripts. Token Kind filters change neither summary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计费 Token 包含直接输入和输出。API 等值费用根据本地对话记录中的模型，按标准公开价格进行估算。Token 类型筛选不会改变任一摘要。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrechnungs-Token umfassen direkte Eingaben und Ausgaben. Das API-Äquivalent schätzt die Kosten zu Standardlistenpreisen anhand der Modelle in lokalen Transkripten. Filter für Token-Typen ändern keine der beiden Zusammenfassungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tokens facturables comprennent les entrées directes et les sorties. L’équivalent API estime le coût au tarif public standard à partir des modèles enregistrés dans les transcriptions locales. Les filtres de type de token ne modifient aucun de ces résumés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "課金対象トークンには、直接入力と出力が含まれます。API 換算額は、ローカルの会話記録に記録されたモデルの標準定価から費用を推定します。トークン種別フィルタは、どちらの概要にも影響しません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчётные токены включают прямой ввод и вывод. Эквивалент API оценивает стоимость по стандартным ценам на основе моделей из локальных журналов. Фильтры типов токенов не влияют ни на один из итогов."
          }
        }
      }
    },
