    "settings.appearance.visibility.footer": {
      "comment": "Explains the Coding Agent visibility matrix and its non-empty-column rule. Tokens is the app tab name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each row is an agent. Choose the surfaces where it appears; Tokens excludes unchecked agents from all summaries and totals. At least one agent must remain visible in each column."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行代表一个 Coding Agent。选择它要显示的位置；取消勾选后，该 Coding Agent 将从 Token 页的所有摘要和合计中排除。每列至少要保留一个可见的 Coding Agent。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile entspricht einem Coding Agent. Wählen Sie die Bereiche, in denen er angezeigt wird; unter „Token“ werden nicht ausgewählte Coding Agents aus allen Zusammenfassungen und Summen ausgeschlossen. In jeder Spalte muss mindestens ein Coding Agent sichtbar bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne correspond à un Coding Agent. Choisissez les emplacements où il apparaît ; dans Tokens, les Coding Agents décochés sont exclus de tous les résumés et totaux. Au moins un Coding Agent doit rester visible dans chaque colonne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行は1つの Coding Agent です。表示する場所を選択してください。「トークン」のチェックを外すと、その Coding Agent はすべての概要と合計から除外されます。各列には少なくとも1つの Coding Agent を表示する必要があります。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка — Coding Agent. Выберите, где он отображается; снятие флажка «Токены» исключает Coding Agent из всех итогов и сумм. В каждом столбце должен оставаться хотя бы один видимый Coding Agent."
          }
        }
      }
    },
