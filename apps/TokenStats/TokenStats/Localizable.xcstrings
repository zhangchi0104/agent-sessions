    "settings.tokens.currency.source.endpoint.credential_warning": {
      "comment": "Warning that custom endpoints must be public, compatible, and contain no credentials.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a public, keyless endpoint compatible with this provider. Do not include credentials or API keys in the URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用与此提供商兼容的公开、无需密钥的端点。请勿在 URL 中包含凭据或 API 密钥。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie einen öffentlichen Endpunkt ohne API-Schlüssel, der mit diesem Anbieter kompatibel ist. Fügen Sie der URL keine Anmeldedaten oder API-Schlüssel hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un point de terminaison public, sans clé API et compatible avec ce fournisseur. N’ajoutez aucun identifiant ni aucune clé API dans l’URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダと互換性がある、公開された API キー不要のエンドポイントを使用してください。URL に認証情報や API キーを含めないでください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте общедоступную конечную точку без ключа, совместимую с этим поставщиком. Не включайте учетные данные или ключи API в URL."
          }
        }
      }
    },
