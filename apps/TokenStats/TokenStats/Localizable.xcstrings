    "tokens.summary.api_equivalent.exact.help": {
      "comment": "API-equivalent help headed by displayed localized cost and original localized USD cost, followed by the complete localized methodology sentence.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displayed estimate %1$@. Original USD estimate %2$@. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示的估算为 %1$@。原始 USD 估算为 %2$@。%3$@"
          }
        }
      }
    },
    "tokens.summary.api_equivalent.help": {
      "comment": "Detailed API-equivalent estimate help. The argument is the localized price-review date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard API-equivalent estimate by recorded Model; includes all four Token Kinds at list rates regardless of the display filters. The exact USD aggregate is converted first, then the displayed total is rounded upward once at the target currency's minor unit. Claude cache writes without TTL detail use the default 5-minute rate. Prices reviewed %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据记录的模型，按标准公开价格估算 API 等值费用；无论显示筛选如何，均包含全部四种 Token 类型。先换算精确的 USD 合计，再按目标货币的最小单位将显示总额向上取整一次。Claude 缓存写入如无 TTL 详情，则采用默认的 5 分钟费率。价格审核日期：%@。"
          }
        }
      }
    },
    "tokens.summary.api_equivalent.label": {
      "comment": "API-equivalent cost summary label. The first argument is an ISO currency code or localized fallback label; the second is the localized heading-context Token Odometer range.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API-equivalent · %1$@ · %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 等值费用 · %1$@ · %2$@"
          }
        }
      }
    },
    "tokens.summary.api_equivalent.partial.help": {
      "comment": "Detailed partial API-equivalent estimate help. The first argument is the unpriced Token count and drives pluralization; the second is the localized review date; the third is a locale-aware list of localized fallback labels and invariant Model IDs.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Standard API-equivalent estimate by recorded Model; includes all four Token Kinds at list rates regardless of the display filters. The exact USD aggregate is converted first, then the displayed total is rounded upward once at the target currency's minor unit. Claude cache writes without TTL detail use the default 5-minute rate. Prices reviewed %2$@. Unpriced Models: %3$@ (%1$lld token)."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Standard API-equivalent estimate by recorded Model; includes all four Token Kinds at list rates regardless of the display filters. The exact USD aggregate is converted first, then the displayed total is rounded upward once at the target currency's minor unit. Claude cache writes without TTL detail use the default 5-minute rate. Prices reviewed %2$@. Unpriced Models: %3$@ (%1$lld tokens)."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "根据记录的模型，按标准公开价格估算 API 等值费用；无论显示筛选如何，均包含全部四种 Token 类型。先换算精确的 USD 合计，再按目标货币的最小单位将显示总额向上取整一次。Claude 缓存写入如无 TTL 详情，则采用默认的 5 分钟费率。价格审核日期：%2$@。未定价模型：%3$@（%1$lld 个 Token）。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "根据记录的模型，按标准公开价格估算 API 等值费用；无论显示筛选如何，均包含全部四种 Token 类型。先换算精确的 USD 合计，再按目标货币的最小单位将显示总额向上取整一次。Claude 缓存写入如无 TTL 详情，则采用默认的 5 分钟费率。价格审核日期：%2$@。未定价模型：%3$@（%1$lld 个 Token）。"
                }
              }
            }
          }
        }
      }
    },
