          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind noch keine Kurse zwischengespeichert. Schließen Sie diese Liste und wählen Sie „Kurse aktualisieren“, um die %@-Währungstabelle zu laden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
