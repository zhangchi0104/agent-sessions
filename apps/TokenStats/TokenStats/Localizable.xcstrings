    "onboarding.accounts.subtitle": {
      "comment": "Instructions for the optional account connection step. TokenStats is the app name and Settings is its settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in so TokenStats can read your usage. Connect one or both — or skip and do it later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，TokenStats 即可读取你的用量。你可以连接一个或两个 Coding Agent，也可以跳过此步，稍后在“设置”中操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich an, damit TokenStats Ihre Nutzung auslesen kann. Verbinden Sie einen oder beide Coding Agents – oder überspringen Sie diesen Schritt und erledigen Sie dies später in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour permettre à TokenStats de lire votre utilisation. Connectez un ou deux comptes, ou ignorez cette étape et faites-le plus tard dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats が使用状況を読み取れるようにサインインします。1つまたは両方の Coding Agent を接続するか、この手順をスキップして後で「設定」から接続できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы TokenStats мог получать данные об использовании. Подключите один или оба Coding Agent либо пропустите этот шаг и сделайте это позже в Настройках."
          }
        }
      }
    },
    "onboarding.accounts.title": {
      "comment": "Title for the onboarding step where Coding Agent accounts are connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your agents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的 Coding Agent"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding Agents verbinden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez vos Coding Agents"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding Agent を接続"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Coding Agent"
          }
        }
      }
    },
    "onboarding.disclosure.keychain.detail": {
      "comment": "Explains how OAuth access tokens are approved and stored. TokenStats, macOS, and Keychain are product names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in opens your browser to approve TokenStats. The access tokens are saved in your macOS Keychain and used only to read your usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时会打开浏览器，以授权 TokenStats。访问 Token 会保存在 macOS 钥匙串中，仅用于读取你的用量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Anmeldung wird Ihr Browser geöffnet, damit Sie TokenStats autorisieren können. Die Zugriffs-Token werden in Ihrem macOS-Schlüsselbund gespeichert und ausschließlich zum Auslesen Ihrer Nutzung verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion ouvre votre navigateur pour approuver TokenStats. Les tokens d’accès sont enregistrés dans le trousseau macOS et utilisés uniquement pour lire votre utilisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインするとブラウザが開き、TokenStats を承認できます。アクセストークンは macOS のキーチェーンに保存され、使用状況の読み取りにのみ使用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При входе откроется браузер для подтверждения доступа TokenStats. Токены доступа сохраняются в Связке ключей macOS и используются только для чтения данных об использовании."
          }
        }
      }
    },
    "onboarding.disclosure.keychain.title": {
      "comment": "Privacy disclosure heading. Keychain is Apple's credential store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens stay in your Keychain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 保存在钥匙串中"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token bleiben in Ihrem Schlüsselbund"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos tokens restent dans votre trousseau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはキーチェーンに保存されます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токены остаются в Связке ключей"
          }
        }
      }
    },
    "onboarding.disclosure.local_work.detail": {
      "comment": "Explains that Token Odometer data is read locally and never uploaded. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your token counts are read from your agents' transcript files on this Mac. TokenStats reads them and uploads nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Token 数量来自这台 Mac 上 Coding Agent 的对话记录文件。TokenStats 只会在本地读取，不会上传任何内容。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzahl Ihrer Token wird aus den Transkriptdateien Ihrer Coding Agents auf diesem Mac ermittelt. TokenStats liest diese Dateien lokal und lädt nichts hoch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de tokens est lu dans les fichiers de transcription de vos Coding Agents sur ce Mac. TokenStats les lit sans rien téléverser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークン数は、この Mac にある Coding Agent の会話記録ファイルから読み取られます。TokenStats はローカルで読み取り、何もアップロードしません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество токенов считывается из файлов журналов Coding Agent на этом Mac. TokenStats читает их локально и ничего не загружает."
          }
        }
      }
    },
    "onboarding.disclosure.local_work.title": {
      "comment": "Privacy disclosure heading explaining that local work data is not uploaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing about your work leaves your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作内容不会离开这台 Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Informationen über Ihre Arbeit verlassen Ihren Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée concernant votre travail ne quitte votre Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業内容が Mac の外に送信されることはありません"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные о вашей работе не покидают Mac"
          }
        }
      }
    },
    "onboarding.disclosure.optional.footer": {
      "comment": "Footer explaining that onboarding choices can be changed later. Settings is the app's settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every step is optional — you can skip any of them and change these later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个步骤都可以跳过，你也可以稍后在“设置”中更改这些选项。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Schritt ist optional – Sie können ihn überspringen und diese Auswahl später in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étape est facultative : vous pouvez en ignorer une et modifier ces choix plus tard dans Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての手順は任意です。どの手順もスキップでき、後で「設定」から変更できます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все шаги необязательны: любой из них можно пропустить, а параметры изменить позже в Настройках."
          }
        }
      }
    },
    "onboarding.disclosure.providers.detail": {
      "comment": "Privacy disclosure about usage requests. Claude and OpenAI are brand names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage is fetched directly from Claude and OpenAI. Your tokens and usage are never sent to any other server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量数据直接从 Claude 和 OpenAI 获取。你的 Token 与用量绝不会发送到其他服务器。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzung wird direkt von Claude und OpenAI abgerufen. Ihre Token und Nutzungsdaten werden niemals an einen anderen Server gesendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilisation est récupérée directement auprès de Claude et d’OpenAI. Vos tokens et vos données d’utilisation ne sont jamais envoyés à un autre serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用状況は Claude と OpenAI から直接取得されます。トークンや使用状況が他のサーバーに送信されることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные об использовании загружаются напрямую из Claude и OpenAI. Ваши токены и данные об использовании никогда не отправляются на другие серверы."
          }
        }
      }
    },
    "onboarding.disclosure.providers.title": {
      "comment": "Privacy disclosure heading explaining which remote services receive requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your providers are contacted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅向你的服务提供商发起请求"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Ihre Anbieter werden kontaktiert"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls vos fournisseurs sont contactés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通信先は利用中のサービスだけです"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связь только с вашими сервисами"
          }
        }
      }
    },
    "onboarding.disclosure.subtitle": {
      "comment": "Introduces the onboarding privacy disclosure. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next step connects your accounts. Here's exactly what TokenStats accesses — and what it never does."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步将连接你的账户。下面将准确说明 TokenStats 会访问哪些内容，以及绝不会进行哪些操作。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im nächsten Schritt werden Ihre Konten verbunden. Hier erfahren Sie genau, worauf TokenStats zugreift – und was TokenStats niemals tut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étape suivante connecte vos comptes. Voici précisément les données auxquelles TokenStats accède et ce qu’il ne fait jamais."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の手順でアカウントを接続します。TokenStats がアクセスする内容と、決して行わないことを正確に説明します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На следующем шаге будут подключены ваши учётные записи. Здесь точно указано, к чему TokenStats получает доступ и чего никогда не делает."
          }
        }
      }
    },
    "onboarding.disclosure.title": {
      "comment": "Title for the privacy disclosure shown before account sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor Sie beginnen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de commencer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始める前に"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед началом"
          }
        }
      }
    },
