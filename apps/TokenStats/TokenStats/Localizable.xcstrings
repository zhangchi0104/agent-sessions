{
  "sourceLanguage": "en",
  "strings": {
    "account.sign_in.agent.button": {
      "comment": "Button that starts sign-in. The argument is an unlocalized Coding Agent brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 %@"
          }
        }
      }
    },
    "account.sign_in.automatic.instruction": {
      "comment": "Instruction shown during a self-completing browser OAuth flow. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve in your browser; TokenStats finishes automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中授权；TokenStats 将自动完成登录。"
          }
        }
      }
    },
    "account.sign_in.callback.failure.body": {
      "comment": "Body on a failed OAuth callback page. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No authorization code was found. Return to TokenStats and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到授权码。请返回 TokenStats 后重试。"
          }
        }
      }
    },
    "account.sign_in.callback.failure.heading": {
      "comment": "Heading on a failed OAuth browser callback page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败"
          }
        }
      }
    },
    "account.sign_in.callback.success.body": {
      "comment": "Body on the successful OAuth callback page. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this tab and return to TokenStats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以关闭此标签页并返回 TokenStats。"
          }
        }
      }
    },
    "account.sign_in.callback.success.heading": {
      "comment": "Heading on the successful Codex OAuth browser callback page. Codex is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in to Codex"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录 Codex"
          }
        }
      }
    },
    "account.sign_in.error.authorization": {
      "comment": "OAuth authorization failure diagnostic. The argument is raw provider detail and must not be translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization failed: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权失败：%@"
          }
        }
      }
    },
    "account.sign_in.error.cancelled": {
      "comment": "OAuth error when the loopback listener is cancelled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in was cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已取消。"
          }
        }
      }
    },
    "account.sign_in.error.local_port": {
      "comment": "OAuth error when TokenStats cannot bind a loopback port.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open a local port for sign-in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开用于登录的本地端口。"
          }
        }
      }
    },
    "account.sign_in.error.malformed_redirect": {
      "comment": "OAuth error when the browser callback request is malformed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in redirect was malformed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录重定向格式有误。"
          }
        }
      }
    },
    "account.sign_in.error.missing_refresh_token": {
      "comment": "OAuth error when the provider omits the refresh token needed to keep the account signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in did not return a refresh token; cannot stay signed in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录未返回刷新 Token，无法保持登录状态。"
          }
        }
      }
    },
    "account.sign_in.error.state_mismatch": {
      "comment": "OAuth error when the returned state does not match the generated state.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State mismatch — possible interference; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态不匹配——可能受到干扰，请重试。"
          }
        }
      }
    },
    "account.sign_in.error.timed_out": {
      "comment": "OAuth error when browser approval does not finish before the timeout.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in timed out. Approve in the browser, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录超时。请在浏览器中授权后重试。"
          }
        }
      }
    },
    "account.sign_in.error.pasted_code_unsupported": {
      "comment": "Internal sign-in error shown if a paste-code completion is requested for an agent whose OAuth flow does not accept pasted codes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Coding Agent does not sign in with a pasted code."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Coding Agent 不使用粘贴授权码的方式登录。"
          }
        }
      }
    },
    "account.sign_in.failed.summary": {
      "comment": "User-facing sign-in failure summary. Raw provider details are kept in diagnostics.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in failed. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败，请重试。"
          }
        }
      }
    },
    "account.sign_in.paste_code.field": {
      "comment": "Placeholder for the OAuth code text field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴授权码"
          }
        }
      }
    },
    "account.sign_in.paste_code.instruction": {
      "comment": "Instruction shown during a paste-code OAuth flow. TokenStats is a brand name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve TokenStats in your browser, then paste the code here:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中授权 TokenStats，然后将授权码粘贴到此处："
          }
        }
      }
    },
    "account.sign_in.reopen_browser.button": {
      "comment": "Button that reopens the browser during an OAuth sign-in flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-open browser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开浏览器"
          }
        }
      }
    },
    "account.sign_in.submit.button": {
      "comment": "Button that submits a pasted OAuth code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交"
          }
        }
      }
    },
    "account.status.awaiting_code": {
      "comment": "Status label while waiting for the user to paste an OAuth code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待授权码"
          }
        }
      }
    },
    "account.status.connected": {
      "comment": "Status label for a connected Coding Agent account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接"
          }
        }
      }
    },
    "account.status.signed_out": {
      "comment": "Status label for a Coding Agent account that is not signed in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录"
          }
        }
      }
    },
    "command.settings.title": {
      "comment": "Application menu command that opens the TokenStats settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置…"
          }
        }
      }
    },
    "onboarding.accounts.primary_subscription.footer": {
      "comment": "Explains how the selected primary subscription is presented.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown first and badged in the popover and menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在弹出窗口和菜单栏中置顶显示并标记。"
          }
        }
      }
    },
    "onboarding.accounts.primary_subscription.title": {
      "comment": "Label for choosing which Coding Agent subscription is presented first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary subscription"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要订阅"
          }
        }
      }
    },
    "onboarding.accounts.subtitle": {
      "comment": "Instructions for the optional account connection step. TokenStats is the app name and Settings is its settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in so TokenStats can read your usage. Connect one or both — or skip and do it later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，TokenStats 即可读取你的用量。你可以连接一个或两个 Coding Agent，也可以跳过此步，稍后在“设置”中操作。"
          }
        }
      }
    },
    "onboarding.accounts.title": {
      "comment": "Title for the onboarding step where Coding Agent accounts are connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your agents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接你的 Coding Agent"
          }
        }
      }
    },
    "onboarding.disclosure.keychain.detail": {
      "comment": "Explains how OAuth access tokens are approved and stored. TokenStats, macOS, and Keychain are product names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in opens your browser to approve TokenStats. The access tokens are saved in your macOS Keychain and used only to read your usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录时会打开浏览器，以授权 TokenStats。访问 Token 会保存在 macOS 钥匙串中，仅用于读取你的用量。"
          }
        }
      }
    },
    "onboarding.disclosure.keychain.title": {
      "comment": "Privacy disclosure heading. Keychain is Apple's credential store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens stay in your Keychain"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 保存在钥匙串中"
          }
        }
      }
    },
    "onboarding.disclosure.local_work.detail": {
      "comment": "Explains that Token Odometer data is read locally and never uploaded. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your token counts are read from your agents' transcript files on this Mac. TokenStats reads them and uploads nothing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Token 数量来自这台 Mac 上 Coding Agent 的对话记录文件。TokenStats 只会在本地读取，不会上传任何内容。"
          }
        }
      }
    },
    "onboarding.disclosure.local_work.title": {
      "comment": "Privacy disclosure heading explaining that local work data is not uploaded.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing about your work leaves your Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的工作内容不会离开这台 Mac"
          }
        }
      }
    },
    "onboarding.disclosure.optional.footer": {
      "comment": "Footer explaining that onboarding choices can be changed later. Settings is the app's settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every step is optional — you can skip any of them and change these later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个步骤都可以跳过，你也可以稍后在“设置”中更改这些选项。"
          }
        }
      }
    },
    "onboarding.disclosure.providers.detail": {
      "comment": "Privacy disclosure about usage requests. Claude and OpenAI are brand names.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage is fetched directly from Claude and OpenAI. Your tokens and usage are never sent to any other server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量数据直接从 Claude 和 OpenAI 获取。你的 Token 与用量绝不会发送到其他服务器。"
          }
        }
      }
    },
    "onboarding.disclosure.providers.title": {
      "comment": "Privacy disclosure heading explaining which remote services receive requests.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your providers are contacted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅向你的服务提供商发起请求"
          }
        }
      }
    },
    "onboarding.disclosure.subtitle": {
      "comment": "Introduces the onboarding privacy disclosure. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next step connects your accounts. Here's exactly what TokenStats accesses — and what it never does."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一步将连接你的账户。下面将准确说明 TokenStats 会访问哪些内容，以及绝不会进行哪些操作。"
          }
        }
      }
    },
    "onboarding.disclosure.title": {
      "comment": "Title for the privacy disclosure shown before account sign-in.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before you start"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前"
          }
        }
      }
    },
    "onboarding.done.connected_agents.summary": {
      "comment": "Summary of connected Coding Agent accounts. The first number is connected and the second is available. Configure plural variants for the connected count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld of %2$@ agent connected"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$lld of %2$@ agents connected"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "已连接 %1$lld/%2$@ 个 Coding Agent"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "已连接 %1$lld/%2$@ 个 Coding Agent"
                }
              }
            }
          }
        }
      }
    },
    "onboarding.done.footer": {
      "comment": "Final onboarding note explaining where TokenStats lives and how to reopen setup. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats lives in your menu bar. You can reconnect agents or revisit this setup anytime from Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 位于菜单栏中。你可以随时在“设置”中重新连接 Coding Agent 或再次进行设置。"
          }
        }
      }
    },
    "onboarding.done.no_connected_agents.summary": {
      "comment": "Summary shown when onboarding finishes without a connected Coding Agent account.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agents connected yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未连接 Coding Agent"
          }
        }
      }
    },
    "onboarding.done.primary_agent.summary": {
      "comment": "Summary naming the primary Coding Agent. The inserted agent name is a brand name and must remain unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Primary: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要订阅：%@"
          }
        }
      }
    },
    "onboarding.done.title": {
      "comment": "Confirmation title on the final onboarding step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're all set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切就绪"
          }
        }
      }
    },
    "onboarding.navigation.back.button": {
      "comment": "Button that moves to the previous onboarding step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "onboarding.navigation.continue.button": {
      "comment": "Button that moves to the next onboarding step.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "onboarding.navigation.finish.button": {
      "comment": "Button that completes and closes the onboarding flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "onboarding.navigation.skip.button": {
      "comment": "Button that dismisses the optional onboarding flow.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳过"
          }
        }
      }
    },
    "onboarding.welcome.title": {
      "comment": "Title at the top of the TokenStats onboarding window. TokenStats is the app name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to TokenStats"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 TokenStats"
