    "tokens.summary.api_equivalent.currency.usd_base": {
      "comment": "Exchange-rate disclosure when USD is displayed directly as the canonical pricing currency.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USD is the pricing currency; no FX rate date or fetch time applies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "USD 是定价货币，因此不适用汇率报价日期或获取时间。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "USD ist die Preiswährung; daher gelten weder Kursdatum noch Abrufzeit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’USD est la devise de tarification ; aucune date de taux ni heure de récupération ne s’applique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "USD が価格の基準通貨であるため、為替レートの日付や取得日時は適用されません。"
          }
