    "settings.appearance.token_values.footer": {
      "comment": "Explains how the Token Kind value presentation affects enabled and disabled columns. Token Kind is a product term.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled Token Kinds use this format. Disabled kinds keep a dimmed raw value and are excluded from composition percentages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用的 Token 类型使用此格式。停用的类型保留灰显的原始数值，并从构成百分比中排除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivierte Token-Typen verwenden dieses Format. Deaktivierte Typen behalten einen ausgegrauten Rohwert und werden bei den prozentualen Anteilen nicht berücksichtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les types de token activés utilisent ce format. Les types désactivés conservent une valeur brute estompée et sont exclus des pourcentages de composition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なトークン種別にはこの形式を使用します。無効な種別は元の値を薄く表示し、構成比には含めません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включённые типы токенов используют этот формат. Для отключённых типов сохраняется приглушённое исходное значение, и они не учитываются при расчёте процентного состава."
          }
        }
      }
    },
