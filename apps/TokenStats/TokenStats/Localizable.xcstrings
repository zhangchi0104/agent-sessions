    "account.sign_in.submit.button": {
      "comment": "Button that submits a pasted OAuth code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absenden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить"
          }
        }
      }
