    "settings.tokens.currency.source.endpoint.verification_footer": {
      "comment": "Footer explaining atomic source verification and lack of automatic failover.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats verifies the endpoint before switching. It contacts only the selected endpoint and never fails over to another service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 会在切换前验证端点。它只联系所选端点，绝不会自动故障转移到其他服务。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats überprüft den Endpunkt vor dem Wechsel. Es kontaktiert nur den ausgewählten Endpunkt und wechselt bei Fehlern nie zu einem anderen Dienst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats vérifie le point de terminaison avant de basculer. Il contacte uniquement le point de terminaison sélectionné et ne bascule jamais vers un autre service en cas d’échec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats は切り替える前にエンドポイントを検証します。選択したエンドポイントにのみ接続し、別のサービスへ自動的にフェイルオーバーすることはありません。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats проверяет конечную точку перед переключением. Приложение обращается только к выбранной конечной точке и никогда не переключается на другой сервис автоматически."
          }
        }
      }
    },
    "settings.tokens.currency.source.validation_error.accessibility_label": {
      "comment": "Accessibility summary for a source validation failure. The argument is the diagnostic message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not use rate provider. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用汇率提供商。%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursanbieter konnte nicht verwendet werden. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser le fournisseur de taux. %@"
