    "settings.general.language.restart.deferred": {
      "comment": "Confirmation shown after the user chooses to restart later.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language will be applied the next time TokenStats starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TokenStats 下次启动时将使用新语言。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Sprache wird beim nächsten Start von TokenStats verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue sera appliquée au prochain démarrage de TokenStats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回 TokenStats を起動したときに新しい言語が適用されます。"
