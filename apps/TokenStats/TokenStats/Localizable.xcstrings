    "settings.general.language.footer": {
      "comment": "Explains restart behavior and that language does not replace regional formatting preferences.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language changes apply to TokenStats after it restarts. Numbers, dates, and USD amounts continue to use your Mac's regional formats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言更改将在 TokenStats 重启后生效。数字、日期和美元金额仍使用 Mac 的地区格式。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachänderungen werden nach einem Neustart von TokenStats angewendet. Zahlen, Datumsangaben und USD-Beträge verwenden weiterhin die regionalen Formate Ihres Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements de langue s’appliquent à TokenStats après son redémarrage. Les nombres, les dates et les montants en USD continuent d’utiliser les formats régionaux de votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更は TokenStats の再起動後に適用されます。数値、日付、米ドル金額には引き続き Mac の地域形式が使用されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение языка TokenStats применяется после перезапуска. Форматы чисел, дат и сумм в долларах США по-прежнему определяются региональными настройками Mac."
          }
        }
      }
    },
