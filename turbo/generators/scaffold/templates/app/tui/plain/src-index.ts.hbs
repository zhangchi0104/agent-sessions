const ESC = "\x1B[";
const stdin = process.stdin;

const render = (): void => {
  process.stdout.write(`${ESC}2J${ESC}H`);
  process.stdout.write("@repo/{{ packageName }}\n\n");
  process.stdout.write("Interactive terminal UI\n\n");
  process.stdout.write("Press q or Ctrl+C to quit.\n");
};

const cleanup = (): void => {
  stdin.setRawMode(false);
  stdin.pause();
  process.stdout.write(`${ESC}?25h${ESC}0m\n`);
};

stdin.setEncoding("utf8");
stdin.setRawMode(true);
stdin.resume();
process.stdout.write(`${ESC}?25l`);
render();

stdin.on("data", (key) => {
  if (key === "q" || key === "\u0003") {
    cleanup();
    process.exit(0);
  }
});
