    "@repo/biome-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "drizzle-orm": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
